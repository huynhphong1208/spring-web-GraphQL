type Query {
    productsSortedByPriceAsc: [Product]
    productsByCategoryId(categoryId: ID!): [Product]
    searchProducts(name: String, page: Int, size: Int): ProductPage
    searchCategories(name: String, page: Int, size: Int): CategoryPage
    allCategories: [Category]
}

type Mutation {
    createProduct(product: ProductInput!): Product
    updateProduct(id: ID!, product: ProductInput!): Product
    deleteProduct(id: ID!): Boolean

    createCategory(category: CategoryInput!): Category
    updateCategory(id: ID!, category: CategoryInput!): Category
    deleteCategory(id: ID!): Boolean
}

type Product {
    id: ID!
    name: String!
    price: Float!
    quantity: Int!
    description: String
    images: String
    category: Category
}

type Category {
    id: ID!
    name: String!
    icon: String
    products: [Product]
}

type ProductPage {
    content: [Product]
    totalPages: Int!
    totalElements: Int!
    pageNumber: Int!
    pageSize: Int!
}

type CategoryPage {
    content: [Category]
    totalPages: Int!
    totalElements: Int!
    pageNumber: Int!
    pageSize: Int!
}

input ProductInput {
    name: String!
    price: Float!
    quantity: Int!
    description: String
    images: String
    categoryId: ID!
}

input CategoryInput {
    name: String!
    icon: String
}
